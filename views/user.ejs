<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Meu Perfil</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="main-container" style="max-width: 900px; margin-top: 40px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
      <h1>Painel do Utilizador: <%= usuario.user %></h1>
      <a href="/home" class="btn" style="background: #475569; text-decoration: none; padding: 8px 16px; border-radius: 6px; color: white;">Voltar ao Catálogo</a>
    </div>

    <!-- Livros Favoritados -->
    <div style="background: white; padding: 25px; border-radius: 12px; margin-top: 20px; border: 1px solid var(--border);">
      <h3>Livros Favoritados</h3>
      <% if (livros && livros.length > 0) { %>
        <ul style="margin-top: 15px; list-style: none; padding: 0;">
          <% livros.forEach(livro => { %>
            <% if (livro) { %>
              <li style="display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-bottom: 1px solid #f1f5f9;">
                <span><strong><%= livro.titulo %></strong> (<%= livro.autor %>)</span>
                <div style="display: flex; gap: 10px; align-items: center;">
                  <a href="/book/<%= livro._id %>" style="color: #2563eb; text-decoration: none; font-weight: 600;">Ver</a>
                  <form action="/unfavorite/<%= livro._id %>" method="POST" style="display:inline;">
                    <button type="submit" style="background: #ef4444; color: white; border: none; padding: 4px 8px; border-radius: 4px; cursor: pointer;">Desfavoritar</button>
                  </form>
                </div>
              </li>
            <% } %>
          <% }) %>
        </ul>
      <% } else { %>
        <p style="color: var(--text-muted); margin-top: 10px;">Ainda não favoritou nenhum livro.</p>
      <% } %>
    </div>

    <!-- Gestão de Reviews -->
    <div style="background: white; padding: 25px; border-radius: 12px; margin-top: 20px; border: 1px solid var(--border);">
      <h3>As suas Reviews</h3>
      <% if (reviews && reviews.length > 0) { %>
        <ul style="margin-top: 15px; list-style: none; padding: 0;">
          <% reviews.forEach(rev => { %>
            <li style="padding: 15px 0; border-bottom: 1px solid #f1f5f9; display: flex; justify-content: space-between; align-items: flex-start;">
              <div>
                <strong><%= rev.tituloLivro %></strong> - Nota: <%= rev.nota %>/5
                <p style="margin: 5px 0; color: var(--text-muted);"><%= rev.comentario %></p>
              </div>
              <div style="display: flex; gap: 10px;">
                <a href="/book/<%= rev.bookId %>" style="font-size: 13px; color: #2563eb; text-decoration: none; font-weight: 600;">Editar</a>
                <form action="/review/delete/<%= rev._id %>" method="POST" style="display:inline;">
                  <button type="submit" style="background: none; border: none; color: #ef4444; cursor: pointer; font-size: 13px; font-weight: 600;">Excluir</button>
                </form>
              </div>
            </li>
          <% }) %>
        </ul>
      <% } else { %>
        <p style="color: var(--text-muted); margin-top: 10px;">Ainda não fez nenhuma review.</p>
      <% } %>
    </div>

    <!-- Excluir Conta -->
    <div style="margin-top: 30px; text-align: right;">
      <form action="/user/delete" method="POST" onsubmit="return confirm('Tem certeza absoluta que deseja excluir a sua conta?');">
        <button type="submit" style="background: #dc2626; color: white; border: none; padding: 10px 16px; border-radius: 6px; cursor: pointer; font-weight: bold;">Excluir Minha Conta</button>
      </form>
    </div>
  </div>
</body>
</html>