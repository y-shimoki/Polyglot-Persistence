<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Painel do Utilizador - Bookstore</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Header Superior Estilo E-commerce -->
  <header class="store-header">
    <div class="header-top">
      <a href="/home" class="logo-text">📚 Bookstore</a>
      <div class="header-actions">
        <a href="/home">🏠 Voltar à Home</a>
      </div>
    </div>
  </header>

  <!-- Container Principal do Painel -->
  <div class="main-container" style="max-width: 900px; margin: 40px auto; padding: 0 20px;">
    
    <!-- Cabeçalho do Perfil Personalizado -->
    <div style="background: white; padding: 30px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04); border: 1px solid var(--border); margin-bottom: 30px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px;">
      <div style="display: flex; align-items: center; gap: 20px;">
        <!-- Avatar com a inicial do utilizador -->
        <div style="width: 65px; height: 65px; background: linear-gradient(135deg, #1e3a8a, #3b82f6); color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 26px; font-weight: bold; text-transform: uppercase; box-shadow: 0 4px 10px rgba(30, 58, 138, 0.2);">
          <%= usuario.nome.charAt(0) %>
        </div>
        <div>
          <h1 style="font-size: 24px; font-weight: 800; color: var(--text-main); margin: 0 0 5px 0;">Olá, <%= usuario.nome %>! </h1>
          <p style="color: var(--text-muted); font-size: 14px; margin: 0;">Membro ativo da nossa comunidade literária.</p>
        </div>
      </div>

      <!-- Botão Terminar Sessão -->
      <div>
        <a href="/logout" class="btn" style="background-color: #dc2626; padding: 10px 20px; font-size: 14px; display: inline-block; text-decoration: none; border-radius: 6px;"> Terminar Sessão</a>
      </div>
    </div>

    <!-- Painel do Administrador (Aparece apenas se for admin) -->
    <% if (isAdmin) { %>
      <div class="admin-panel" style="background: #fffbeb; border: 1px solid #fde68a; padding: 25px; border-radius: 12px; margin-bottom: 30px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04);">
        <h3 style="color: #b45309; margin-top: 0; font-size: 18px; margin-bottom: 15px;">⚙️ Painel do Administrador</h3>
        <form action="/admin/add-book" method="POST" style="display: flex; flex-direction: column; gap: 12px;">
          <div>
            <label style="font-size: 13px; font-weight: 600; color: #475569;">Título do Livro:</label>
            <input type="text" name="titulo" required style="margin-top: 4px;">
          </div>
          <div>
            <label style="font-size: 13px; font-weight: 600; color: #475569;">Autor(a):</label>
            <input type="text" name="autor" required style="margin-top: 4px;">
          </div>
          <div style="display: flex; gap: 15px;">
            <div style="flex: 1;">
              <label style="font-size: 13px; font-weight: 600; color: #475569;">Gêneros:</label>
              <input type="text" name="generos" required style="margin-top: 4px;">
            </div>
            <div style="flex: 1;">
              <label style="font-size: 13px; font-weight: 600; color: #475569;">Preço (R$):</label>
              <input type="text" name="preco" required style="margin-top: 4px;">
            </div>
          </div>
          <div>
            <label style="font-size: 13px; font-weight: 600; color: #475569;">Sinopse:</label>
            <textarea name="sinopse" rows="3" required style="margin-top: 4px;"></textarea>
          </div>
          <button type="submit" class="btn" style="background-color: #d97706; width: fit-content; padding: 10px 20px;">Adicionar Livro ao Catálogo</button>
        </form>
      </div>
    <% } %>

    <!-- Estatísticas / Informações da Conta -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 20px; margin-bottom: 30px;">
      <div style="background: white; padding: 22px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04); border: 1px solid var(--border); border-left: 5px solid #2563eb;">
        <p style="color: var(--text-muted); font-size: 13px; margin: 0 0 5px 0; font-weight: 600; text-transform: uppercase;">Saldo Disponível</p>
        <p style="font-size: 24px; font-weight: 800; color: var(--success); margin: 0;">R$ <%= usuario.saldo %></p>
      </div>
      <div style="background: white; padding: 22px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04); border: 1px solid var(--border); border-left: 5px solid #8b5cf6;">
        <p style="color: var(--text-muted); font-size: 13px; margin: 0 0 5px 0; font-weight: 600; text-transform: uppercase;">Livros na Biblioteca</p>
        <p style="font-size: 24px; font-weight: 800; color: var(--text-main); margin: 0;"><%= usuario.livrosComprados ? usuario.livrosComprados.length : 0 %></p>
      </div>
      <div style="background: white; padding: 22px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04); border: 1px solid var(--border); border-left: 5px solid #f59e0b;">
        <p style="color: var(--text-muted); font-size: 13px; margin: 0 0 5px 0; font-weight: 600; text-transform: uppercase;">Avaliações Feitas</p>
        <p style="font-size: 24px; font-weight: 800; color: var(--text-main); margin: 0;"><%= usuario.reviews ? usuario.reviews.length : 0 %></p>
      </div>
    </div>

    <!-- Livros Comprados -->
    <div style="background: white; padding: 25px 30px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04); border: 1px solid var(--border); margin-bottom: 25px;">
      <h3 style="font-size: 18px; color: var(--text-main); margin-top: 0; margin-bottom: 15px; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px;">📚 Meus Livros Comprados</h3>
      <% if (typeof usuario.livrosComprados !== 'undefined' && usuario.livrosComprados.length > 0) { %>
        <ul style="margin: 0; padding-left: 20px;">
          <% usuario.livrosComprados.forEach(livro => { %>
            <li style="padding: 8px 0; font-weight: 500; color: var(--text-main); font-size: 15px;"><%= livro %></li>
          <% }) %>
        </ul>
      <% } else { %>
        <div style="text-align: center; padding: 20px; color: var(--text-muted);">
          <p style="font-style: italic; margin: 0;">Ainda não comprou nenhum livro. Explore o catálogo e comece a sua leitura!</p>
          <a href="/home" class="btn" style="display: inline-block; margin-top: 15px; font-size: 13px; padding: 8px 16px;">Ver Catálogo</a>
        </div>
      <% } %>
    </div>

    <!-- Minhas Reviews -->
    <div style="background: white; padding: 25px 30px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04); border: 1px solid var(--border);">
      <h3 style="font-size: 18px; color: var(--text-main); margin-top: 0; margin-bottom: 15px; border-bottom: 2px solid #f1f5f9; padding-bottom: 8px;">⭐ Minhas Avaliações</h3>
      <% if (typeof usuario.reviews !== 'undefined' && usuario.reviews.length > 0) { %>
        <% usuario.reviews.forEach(rev => { %>
          <div style="background: #f8fafc; padding: 15px; margin-bottom: 12px; border-radius: 8px; border-left: 4px solid #3b82f6;">
            <p style="margin: 0 0 6px 0; font-size: 14px;"><strong>Livro:</strong> <%= rev.livro %> | <strong>Nota:</strong> <%= rev.nota %> ⭐</p>
            <p style="margin: 0; color: var(--text-muted); font-size: 13px;"><%= rev.texto %></p>
          </div>
        <% }) %>
      <% } else { %>
        <div style="text-align: center; padding: 20px; color: var(--text-muted);">
          <p style="font-style: italic; margin: 0;">Você ainda não fez nenhuma avaliação. Partilhe a sua opinião sobre os livros lidos!</p>
        </div>
      <% } %>
    </div>

  </div>

</body>
</html>