<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel do Administrador</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        .admin-container { max-width: 900px; margin: 30px auto; padding: 20px; background: #fff; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        .form-group { margin-bottom: 12px; }
        .form-group label { display: block; font-weight: bold; margin-bottom: 4px; }
        .form-group input, .form-group textarea { width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        .btn { padding: 8px 14px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .btn-add { background-color: #28a745; color: white; }
        .btn-edit { background-color: #ffc107; color: #000; }
        .btn-delete { background-color: #dc3545; color: white; }
        .book-card { border: 1px solid #ddd; padding: 15px; margin-bottom: 15px; border-radius: 6px; background: #f9f9f9; }
        .actions { display: flex; gap: 10px; margin-top: 10px; }
    </style>
</head>
<body>
    <header style="padding: 15px 30px; background: #222; color: #fff; display: flex; justify-content: space-between; align-items: center;">
        <h1>Painel Admin</h1>
        <nav>
            <a href="/home" style="color: #fff; text-decoration: none; font-weight: bold;">← Voltar para Home</a>
        </nav>
    </header>

    <main class="admin-container">
        <section>
            <h2>Adicionar Novo Livro</h2>
            <form action="/admin/add-book" method="POST">
                <div class="form-group">
                    <label>Título:</label>
                    <input type="text" name="title" required>
                </div>
                <div class="form-group">
                    <label>Autor:</label>
                    <input type="text" name="author" required>
                </div>
                <div class="form-group">
                    <label>Gênero / Categoria:</label>
                    <input type="text" name="genre" required>
                </div>
                <div class="form-group">
                    <label>Descrição / Sinopse:</label>
                    <textarea name="description" rows="3" required></textarea>
                </div>
                <button type="submit" class="btn btn-add">Cadastrar Livro</button>
            </form>
        </section>

        <hr style="margin: 30px 0;">

        <section>
            <h2>Gerenciar Livros Cadastrados</h2>
            <% if (books && books.length > 0) { %>
                <% books.forEach(book => { %>
                    <div class="book-card">
                        <form action="/admin/books/update/<%= book._id %>" method="POST">
                            <div class="form-group">
                                <label>Título:</label>
                                <input type="text" name="title" value="<%= book.title %>" required>
                            </div>
                            <div class="form-group">
                                <label>Autor:</label>
                                <input type="text" name="author" value="<%= book.author %>" required>
                            </div>
                            <div class="form-group">
                                <label>Gênero:</label>
                                <input type="text" name="genre" value="<%= book.genre %>" required>
                            </div>
                            <div class="form-group">
                                <label>Descrição:</label>
                                <textarea name="description" rows="2" required><%= book.description %></textarea>
                            </div>
                            <div class="actions">
                                <button type="submit" class="btn btn-edit">Salvar Alterações</button>
                            </div>
                        </form>

                        <form action="/admin/books/delete/<%= book._id %>" method="POST" style="margin-top: 8px;">
                            <button type="submit" class="btn btn-delete" onclick="return confirm('Tem certeza que deseja excluir este livro?')">Excluir Livro</button>
                        </form>
                    </div>
                <% }) %>
            <% } else { %>
                <p>Nenhum livro cadastrado no momento.</p>
            <% } %>
        </section>
    </main>
</body>
</html>