<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title><%= livro.titulo %> - Detalhes</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>

  <!-- Header Superior Estilo E-commerce Profissional -->
  <header class="store-header">
    <div class="header-top">
      <a href="/home" class="logo-text">📚 Bookstore</a>
      <div class="header-actions">
        <a href="/home">🏠 Voltar à Home</a>
      </div>
    </div>
  </header>

  <!-- Container Principal -->
  <div class="main-container" style="max-width: 900px; margin: 40px auto; padding: 0 20px;">
    
    <!-- Cartão de Informações do Livro -->
    <div style="background: white; padding: 35px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04); border: 1px solid var(--border); margin-bottom: 30px;">
      <span class="book-genre" style="margin-bottom: 15px;"><%= livro.generos %></span>
      <h1 style="margin: 5px 0 15px 0; color: var(--text-main); font-size: 28px;"><%= livro.titulo %></h1>
      
      <p style="color: var(--text-muted); font-size: 15px; margin-bottom: 8px;"><strong>Autor(a):</strong> <%= livro.autor %></p>
      <div class="book-price" style="font-size: 24px; margin: 15px 0;">R$ <%= livro.preco %></div>
      
      <div style="margin: 20px 0; padding-top: 15px; border-top: 1px solid #f1f5f9;">
        <h3 style="font-size: 16px; color: var(--text-main); margin-bottom: 8px;">Sinopse</h3>
        <p style="color: var(--text-muted); font-size: 14px; line-height: 1.7; margin: 0;"><%= livro.sinopse %></p>
      </div>

      <!-- Formulário de Compra -->
      <form action="/buy/<%= livro.titulo %>" method="POST" style="margin-top: 25px;">
        <button type="submit" class="btn" style="background-color: #16a34a; font-size: 16px; padding: 12px 24px; width: fit-content;">🛒 Comprar Livro</button>
      </form>
    </div>

    <!-- Cartão de Avaliações (Reviews) -->
    <div style="background: white; padding: 35px; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0,0,0,0.04); border: 1px solid var(--border); margin-bottom: 30px;">
      <h3 style="font-size: 20px; color: var(--text-main); margin-top: 0; margin-bottom: 20px; border-bottom: 2px solid #f1f5f9; padding-bottom: 10px;">⭐ Avaliações (Reviews)</h3>

      <% if (typeof reviews !== 'undefined' && reviews.length > 0) { %>
        <div style="margin-bottom: 25px;">
          <% reviews.forEach(review => { %>
            <div style="background: #f8fafc; padding: 15px; margin-bottom: 12px; border-radius: 8px; border-left: 4px solid var(--accent-blue);">
              <p style="margin: 0 0 6px 0; font-size: 14px;">
                <strong><%= review.usuario %></strong> — Nota: <%= review.nota %> ⭐
              </p>
              <% if (review.texto) { %>
                <p style="margin: 0; color: var(--text-muted); font-size: 13px;"><%= review.texto %></p>
              <% } %>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <p style="color: var(--text-muted); font-style: italic; margin-bottom: 20px;">Ainda não há reviews para este livro. Seja o primeiro a avaliar!</p>
      <% } %>

      <hr style="border: none; border-top: 1px solid #e2e8f0; margin: 25px 0;">

      <!-- Formulário para Enviar Review -->
      <h4 style="font-size: 18px; color: var(--text-main); margin-bottom: 15px;">Deixe a sua review</h4>
      
      <form action="/review/<%= livro.titulo %>" method="POST" style="display: flex; flex-direction: column; gap: 15px; max-width: 100%;">
        <div>
          <label style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 13px; color: #475569;">Nota (1 a 5 estrelas):</label>
          <input type="number" name="nota" min="1" max="5" value="5" required style="width: 120px; padding: 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 14px;">
        </div>

        <div>
          <label style="display: block; margin-bottom: 6px; font-weight: 600; font-size: 13px; color: #475569;">Comentário:</label>
          <textarea name="texto" placeholder="Escreva sua opinião sobre o livro..." rows="4" style="width: 100%; padding: 12px; border-radius: 6px; border: 1px solid var(--border); box-sizing: border-box; font-family: inherit; font-size: 14px;"></textarea>
        </div>

        <button type="submit" class="btn" style="width: fit-content; padding: 12px 25px;">Enviar Review</button>
      </form>
    </div>

  </div>

</body>
</html>