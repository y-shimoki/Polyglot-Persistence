<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title><%= livro.titulo %> - Detalhes</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="main-container" style="max-width: 800px; margin-top: 40px;">
    <a href="/home" style="text-decoration: none; color: #2563eb; font-weight: 600;">← Voltar para o Catálogo</a>
    
    <div style="background: white; padding: 30px; border-radius: 12px; margin-top: 20px; border: 1px solid var(--border);">
      <span class="book-genre"><%= livro.genero.join(" / ") %></span>
      <h1 style="margin: 10px 0; color: var(--text-main);"><%= livro.titulo %></h1>
      <p style="color: var(--text-muted); font-size: 15px; margin-bottom: 15px;"><strong>Autor(a):</strong> <%= livro.autor %></p>
      <p style="color: var(--text-muted); line-height: 1.6; margin-bottom: 25px;"><%= livro.sinopse %></p>

      <!-- Botão para Favoritar -->
      <form action="/favorite/<%= livro._id %>" method="POST">
        <button type="submit" class="btn" style="background: #16a34a; color: white; padding: 10px 20px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold;">⭐ Favoritar Livro</button>
      </form>
    </div>

    <!-- Seção de Reviews (Atualizar/Criar) -->
    <div style="background: white; padding: 30px; border-radius: 12px; margin-top: 20px; border: 1px solid var(--border);">
      <h3>Escrever / Atualizar Review</h3>

      <form action="/review/<%= livro._id %>" method="POST" style="margin-top: 20px; display: flex; flex-direction: column; gap: 12px;">
        <label>Nota (1 a 5):</label>
        <input type="number" name="nota" min="1" max="5" value="<%= reviewUsuario ? reviewUsuario.nota : 5 %>" required style="padding: 8px; width: 100px; border-radius: 6px; border: 1px solid #cbd5e1;">
        
        <label>Comentário:</label>
        <textarea name="texto" rows="4" placeholder="Escreva a sua review..." style="padding: 8px; border-radius: 6px; border: 1px solid #cbd5e1;"><%= reviewUsuario ? reviewUsuario.comentario : '' %></textarea>
        
        <button type="submit" class="btn" style="width: fit-content; padding: 8px 16px; background-color: green;">Salvar Review</button>
      </form>
      <% if (reviewUsuario) { %>
        <form action="/review/delete/<%= reviewUsuario._id %>" method="POST" style="margin-top: 12px;">
          <button type="submit" class="btn" style="width: fit-content; padding: 8px 16px; background-color: red;">Excluir Review</button>
        </form>
      <% } %>
      <hr style="margin: 30px 0; border: none; border-top: 1px solid #e2e8f0;">

      <h3>Avaliações da Comunidade</h3>
      <div style="margin-top: 15px;">
        <% if (reviews && reviews.length > 0) { %>
          <% reviews.forEach(rev => { %>
            <div style="padding: 15px 0; border-bottom: 1px solid #f1f5f9;">
              <strong><%= rev.user %></strong> - Nota: <%= rev.nota %>/5
              <p style="margin-top: 5px; color: var(--text-muted);"><%= rev.comentario %></p>
            </div>
          <% }) %>
        <% } else { %>
          <p style="color: var(--text-muted);">Ainda não existem reviews para este livro.</p>
        <% } %>
      </div>
    </div>
  </div>
</body>
</html>